<%- include('layout', {
  appName,
  body: `
    <h2>Welcome, ${name}!</h2>
    <p>Thank you for creating an account with <strong>${appName}</strong>. We are excited to have you on board.</p>
    <p>Your account has been set up with the email: <strong>${email}</strong></p>
    <p>You can now log in and start exploring.</p>
    <p style="text-align: center; margin: 32px 0;">
      <a href="${loginUrl}" class="btn">Get Started</a>
    </p>
    <p>If you did not create this account, please ignore this email.</p>
  `
}) %>
